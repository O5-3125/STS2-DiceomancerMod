{
  "DICEOMANCER_EVENT_TEST_ANCIENT.title": "混沌使者",
  "DICEOMANCER_EVENT_TEST_ANCIENT.epithet": "不是混沌神",
  "DICEOMANCER_EVENT_TEST_ANCIENT.talk.firstVisitEver.0-0.ancient": "(｡･∀･)ﾉﾞ嗨！",
  "DICEOMANCER_EVENT_TEST_ANCIENT.talk.ANY.0-0r.ancient": "（这段文本还没编好）",
  "DICEOMANCER_EVENT_TEST_ANCIENT.talk.ANY.1-0r.ancient": "(这段文本还没编好)",
  // 捏奥
  "NEOW.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.0-0.char": "你见到过一位紫色衣服，有两个形态的女神吗？",
  "NEOW.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.0-0.next": "继续",
  "NEOW.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.0-1.ancient": "[sine]... ...向上...[/sine]",
  "NEOW.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.1-0r.ancient": "[sine]...zzz... ..zzz.....[/sine]",
  "NEOW.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.2-0.ancient": "[sine]...你.. 还缺...什么...？[/sine]",
  "NEOW.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.2-0.next": "继续",
  "NEOW.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.2-1.char": "我怀念我的鱼塘了...我想在这儿钓鱼。",
  "NEOW.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.2-1.next": "继续",
  "NEOW.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.2-2.ancient": "[sine]...走吧... \n..塔里... 总会有...更大的鱼... [/sine]",
  //瓦库
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.0-0.ancient": "（面对巨大的恶魔，你感到如此恐惧。）",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.0-0.next": "检定",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.0-1.ancient": "（D20=1，大失败。）\n（你精神崩溃，灵魂被收入瓦库的囊中。）",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.0-1.next": "回应",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.0-2.char": "你是怎么说出括号里的内容的？",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.0-2.next": "继续",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.0-3.ancient": "商业机密。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.1-0.ancient": "（面对巨大的恶魔，你感到如此恐惧。）",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.1-0.next": "检定",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.1-1.char": "（D20=20，大成功。）\n（你将瓦库的灵魂..）",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.1-1.next": "继续",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.1-2.ancient": "等等，什么？",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.1-2.next": "继续",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.1-3.char": "我认识DM。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_DICEOMANCER_CHARACTER.2-0r.ancient": "恶魔-重复对话",
  /*------------- 达弗 × 工匠 ----------- */
  "DARV.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.ancient": "哟！工匠师傅！你这身机油味儿我可太熟了！！\n来来来，我这儿有堆报废的零件和旧工具，看看有没有能[jitter]改装[/jitter]的好料子！",
  "DARV.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.next": "翻找",
  "DARV.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.char": "[i][font_size=22]工匠在一堆废铁里挑挑拣拣，眼里直放光。[/font_size][/i]",
  "DARV.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.next": "继续",
  "DARV.talk.DICEOMANCER_CHARACTER_BUILDER.0-2.ancient": "哈哈！懂行的人就是不一样！\n这堆东西里随便挑一件走吧！",
  "DARV.talk.DICEOMANCER_CHARACTER_BUILDER.1-0r.ancient": "又开工啦？这几天我收了不少好货，看看有没有用得上的！",
  "DARV.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.ancient": "我这儿有件宝贝……是一台能自动干活的机器！\n可惜坏啦……你也知道，我这种人只会收藏，不会修！",
  "DARV.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.next": "回应",
  "DARV.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.char": "坏的？那正好。我最擅长的就是把坏的变成好的。",
  "DARV.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.next": "继续",
  "DARV.talk.DICEOMANCER_CHARACTER_BUILDER.2-2.ancient": "好嘞！就等你这句话！修好了别忘了回来让我开开眼！",
  /*------------- 达弗 × 野蛮人 ----------- */
  "DARV.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.ancient": "好家伙！！这么壮实的大个子！\n来来来，我这儿的收藏就缺一件配得上你的大家伙！",
  "DARV.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.next": "挑选",
  "DARV.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.char": "唔……够重，够硬。就要这个了！",
  "DARV.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.next": "继续",
  "DARV.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-2.ancient": "好眼光！！砸坏了随时回来换！我这儿的货，管够！",
  "DARV.talk.DICEOMANCER_CHARACTER_BARBARIAN.1-0r.ancient": "哟，大个子！听说你脑子也不赖？\n那正好，帮我掌掌眼，这堆东西里哪件最值钱？",
  "DARV.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.ancient": "我留了件好东西给你……一把据说砍过龙的斧子！\n当然啦，我留着也没用，你拿去用吧！",
  "DARV.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.next": "回应",
  "DARV.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.char": "龙？它长什么样？",
  "DARV.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.next": "继续",
  "DARV.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-2.ancient": "唔……听说很大，很凶，还会喷火！\n怎么，你想找它练练手？",
  /*------------- 涅奥 × 工匠 ----------- */
  "NEOW.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.ancient": "[sine]...工匠.. 你...\n..又.. 被.. 带到.. 我面前....[/sine]",
  "NEOW.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.next": "回答",
  "NEOW.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.char": "我还有很多没造完的东西。",
  "NEOW.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.next": "继续",
  "NEOW.talk.DICEOMANCER_CHARACTER_BUILDER.0-2.ancient": "[sine]...造吧.. \n..塔.. 会.. 看着.. 你的....[/sine]",
  "NEOW.talk.DICEOMANCER_CHARACTER_BUILDER.1-0r.ancient": "[sine]..你的.. 双手.. \n..从未.. 停歇....[/sine]",
  "NEOW.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.ancient": "[sine]...你.. 造出的.. 东西.. \n..比你.. 记住的.. 更多....[/sine]",
  "NEOW.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.next": "继续",
  "NEOW.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.ancient": "[sine]...去吧.. \n..有.. 什么.. 忘了.. 就.. 再造.. 出来....[/sine]",
  /*------------- 涅奥 × 野蛮人 ----------- */
  "NEOW.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.ancient": "[sine]...我的.. 战士...\n..你.. 醒来.. 了....[/sine]",
  "NEOW.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.next": "回答",
  "NEOW.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.char": "我睡够了！让我去砸点什么！",
  "NEOW.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.next": "继续",
  "NEOW.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-2.ancient": "[sine]...好.. \n..把.. 怒气.. 用在.. 该用.. 的.. 地方....[/sine]",
  "NEOW.talk.DICEOMANCER_CHARACTER_BARBARIAN.1-0r.ancient": "[sine]..又是.. 你...\n..很好....[/sine]",
  "NEOW.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.ancient": "[sine]...他们说.. 你.. 只有.. 蛮力.. \n..可我.. 看到.. 的.. 更多....[/sine]",
  "NEOW.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.next": "继续",
  "NEOW.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.ancient": "[sine]...去吧.. \n..证明.. 给他们.. 看....[/sine]",
  /*------------- 诺奴佩普 × 工匠 ----------- */
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.ancient": "哎呀，一身油污的工匠！\n你的手艺或许不俗，可这身打扮实在配不上你的才华。",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.next": "回应",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.char": "工作服，耐脏，耐磨。好看又不能当锤子用。",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.next": "继续",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BUILDER.0-2.ancient": "呵呵，说得好。\n那这件沾了仙气儿的围裙，总配得上你的手艺了吧？",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BUILDER.1-0r.ancient": "工匠大人又来了？让我看看……嗯，今天这身还算体面。",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.ancient": "你造的那些大家伙，模样倒是越来越俊俏了。\n来，收下这份赐福，让你的作品也光彩照人！",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.next": "感谢",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.char": "……谢了。要是能给蒸汽坦克上点漆，就更好了。",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.next": "继续",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BUILDER.2-2.ancient": "你呀！",
  /*------------- 诺奴佩普 × 野蛮人 ----------- */
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.ancient": "呀，一位壮士！\n这身腱子肉比任何华服都耀眼，不过……要不要来点点缀？",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.next": "回应",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.char": "我穿这个就能赢。",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.next": "继续",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-2.ancient": "自信的男人最迷人！\n来，这枚护身符，就当是我的一点小小心意。",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BARBARIAN.1-0r.ancient": "勇士又来了！\n我为你准备了新的披风——用朝霞染的色，够威风！",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.ancient": "我听说，外面人都说你只是个莽夫。\n可我看得出来，你心里有数。这份赐福，给你！",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.next": "感谢",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.char": "有数？……我就是知道该怎么把敌人砸扁。",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.next": "继续",
  "NONUPEIPE.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-2.ancient": "哈哈哈哈！这话说得好！够真诚，我喜欢！",
  /*------------- 欧洛巴斯 × 工匠 ----------- */
  "OROBAS.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.ancient": "工匠！！会修东西！！会造东西！！\n为什么在这里？？不回去干活？？",
  "OROBAS.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.next": "回应",
  "OROBAS.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.char": "干活？我这不是在给自己找材料么。",
  "OROBAS.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.next": "继续",
  "OROBAS.talk.DICEOMANCER_CHARACTER_BUILDER.0-2.ancient": "哦哦！！找材料！！好理由！！\n亮闪闪的材料！！这里有！！",
  "OROBAS.talk.DICEOMANCER_CHARACTER_BUILDER.1-0r.ancient": "又来了！！新东西！！要看！！\n拿这个走！！修大东西！！",
  "OROBAS.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.ancient": "蒸汽坦克！！见过！！好吵！！好厉害！！\n[jitter]帮我修一个！！我也想坐！！[/jitter]",
  /*------------- 欧洛巴斯 × 野蛮人 ----------- */
  "OROBAS.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.ancient": "好大的人！！肌肉！！吓人！！\n不吃我？？",
  "OROBAS.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.next": "回应",
  "OROBAS.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.char": "你太小，塞牙缝。",
  "OROBAS.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.next": "继续",
  "OROBAS.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-2.ancient": "哈哈！！不吃就好！！给你好东西！！\n亮闪闪的！！砸人很疼！！",
  "OROBAS.talk.DICEOMANCER_CHARACTER_BARBARIAN.1-0r.ancient": "大个子！！又来了！！\n听说你不傻！！真的假的？？",
  "OROBAS.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.ancient": "试试这个！！\n是给[jitter]聪明[/jitter]的大个子准备的！！",
  /*------------- 佩尔 × 工匠 ----------- */
  "PAEL.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.ancient": "[thinky_dots]工匠……你总是叮叮当当……\n我很久没睡过好觉了……[/thinky_dots]",
  "PAEL.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.next": "道歉",
  "PAEL.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.char": "……抱歉。我习惯了天亮干活，干到天黑。",
  "PAEL.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.next": "继续",
  "PAEL.talk.DICEOMANCER_CHARACTER_BUILDER.0-2.ancient": "[thinky_dots]没有关系……能者多劳……\n拿去……我的一部分血肉……当作补偿……[/thinky_dots]",
  "PAEL.talk.DICEOMANCER_CHARACTER_BUILDER.1-0r.ancient": "[thinky_dots]又在敲敲打打……\n你难道……不困吗……？[/thinky_dots]",
  "PAEL.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.ancient": "[thinky_dots]你的手……比我的梦还忙……\n拿走我的血肉吧……休息一下……没人会责怪你的……[/thinky_dots]",
  "PAEL.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.next": "回应",
  "PAEL.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.char": "等我造完蒸汽坦克，一定睡个三天三夜。",
  "PAEL.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.next": "继续",
  "PAEL.talk.DICEOMANCER_CHARACTER_BUILDER.2-2.ancient": "[thinky_dots]三天三夜……听起来……像是我的好梦……[/thinky_dots]",
  /*------------- 佩尔 × 野蛮人 ----------- */
  "PAEL.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.ancient": "[thinky_dots]呼……你身上的味道……\n像刚烤好的肉……[/thinky_dots]",
  "PAEL.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.next": "回应",
  "PAEL.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.char": "你也饿？我带了排骨，要不要来一块？",
  "PAEL.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.next": "继续",
  "PAEL.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-2.ancient": "[thinky_dots]……不了……我更喜欢……睡着的味道……\n拿走吧……这是你的报酬……[/thinky_dots]",
  "PAEL.talk.DICEOMANCER_CHARACTER_BARBARIAN.1-0r.ancient": "[thinky_dots]你又来了……\n这次……带着吃饱的肚子……很好……[/thinky_dots]",
  "PAEL.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.ancient": "[thinky_dots]壮士……吃完就困……困了就睡……\n这是最幸福的循环……拿去吧……[/thinky_dots]",
  "PAEL.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.next": "回应",
  "PAEL.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.char": "你这说得……比部落里的祭祀还有道理。",
  "PAEL.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.next": "继续",
  "PAEL.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-2.ancient": "[thinky_dots]……呼……呼……[/thinky_dots]",
  /*------------- 坦克斯 × 工匠 ----------- */
  "TANX.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.ancient": "[b]工匠！！你那锤子也能算武器吗！！\n收下这把！这才叫家伙！！[/b]",
  "TANX.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.next": "回应",
  "TANX.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.char": "锤子砸人也好使。不过……多谢了。",
  "TANX.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.next": "继续",
  "TANX.talk.DICEOMANCER_CHARACTER_BUILDER.0-2.ancient": "[b]哈哈！识货！下次带蒸汽坦克来！！\n我要和你的坦克打一场！！[/b]",
  "TANX.talk.DICEOMANCER_CHARACTER_BUILDER.1-0r.ancient": "[b]工匠！！改装得怎么样了！！\n记住！！武器永远不嫌多！！[/b]",
  "TANX.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.ancient": "[b]工匠，与我的武器库一战！！\n赢了，这堆宝贝都是你的！！[/b]",
  "TANX.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.next": "战斗",
  "TANX.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.char": "[i][font_size=22]工匠用随手捡来的废铁打赢了这场奇怪的比试。[/font_size][/i]",
  "TANX.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.next": "继续",
  "TANX.talk.DICEOMANCER_CHARACTER_BUILDER.2-2.ancient": "[b]好家伙！！这叫化废为宝！！收下战利品！[/b]",
  /*------------- 坦克斯 × 野蛮人 ----------- */
  "TANX.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.ancient": "[b]野蛮人！！一看见你我就热血沸腾！！\n来！！先打一架再挑武器！！[/b]",
  "TANX.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.next": "战斗",
  "TANX.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.char": "[i][font_size=22]野蛮人接受了挑战，两人打得山摇地动。[/font_size][/i]",
  "TANX.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.next": "继续",
  "TANX.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-2.ancient": "[b]痛快！！太痛快了！！\n拿上这把斧子！！你是天生的战士！！[/b]",
  "TANX.talk.DICEOMANCER_CHARACTER_BARBARIAN.1-0r.ancient": "[b]野蛮人！！再来一架！！\n听说你还会动脑子？！那就边打边想！！[/b]",
  "TANX.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.ancient": "[b]野蛮人，与我一战！！\n这次输的，要把最得意的武器交出来！！[/b]",
  "TANX.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.next": "战斗",
  "TANX.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.char": "[i][font_size=22]这场战斗打了一天一夜，最后两人都趴在地上大笑。[/font_size][/i]",
  "TANX.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.next": "继续",
  "TANX.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-2.ancient": "[b]哈哈哈哈！！下次！！下次一定要分出胜负！！[/b]",
  /*------------- 特兹卡塔拉 × 工匠 ----------- */
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.ancient": "哎呀，脏兮兮的小工匠！\n你这双手的伤疤，可都是[jitter][b]努力[/b][/jitter]的勋章呀！",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.next": "回应",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.char": "还行。不努力的话，东西造不出来。",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.next": "继续",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BUILDER.0-2.ancient": "真了不起！\n来，吃块刚烤好的点心，空着肚子可没法[jitter][b]干活[/b][/jitter]！",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BUILDER.1-0r.ancient": "工匠宝贝又回来啦！\n今天想让我烧掉点什么？废图纸？坏零件？还是[jitter][b]烦恼[/b][/jitter]？",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.ancient": "你造的那些铁家伙，光靠火候可不够呀。\n来，让我给你的干劲再[jitter][b]添把火[/b][/jitter]！",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.next": "感谢",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.char": "……你的火，我收下了。炉子正缺柴。",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.next": "继续",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BUILDER.2-2.ancient": "呵呵呵，真是个可爱的[jitter][b]实用主义者[/b][/jitter]！",
  /*------------- 特兹卡塔拉 × 野蛮人 ----------- */
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.ancient": "啊呀，好壮的男孩！\n你这身肉，比篝火还让人[jitter][b]暖和[/b][/jitter]呢！",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.next": "回应",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.char": "火？我更喜欢肉被烤熟的香气。",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.next": "继续",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-2.ancient": "哦哦！那我可得好好露一手！\n来，尝尝我这[jitter][b]秘制[/b][/jitter]烤肉！",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BARBARIAN.1-0r.ancient": "勇士回来啦！\n听说你把塔里的怪物都揍了一顿？真能干，来，吃块肉补补！",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.ancient": "我听说外面都说你只有蛮力？\n哼，让他们[jitter][b]闭嘴[/b][/jitter]！吃饱了才有力气证明自己！",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.next": "感谢",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.char": "证明自己？……哼，我先吃为敬。",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.next": "继续",
  "TEZCATARA.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-2.ancient": "慢慢吃，亲爱的。吃饱了，这塔里的[jitter][b]所有人[/b][/jitter]都会认识你！",
  /*------------- 建筑师 × 工匠 ----------- */
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BUILDER.0-0r.ancient": "你为什么要上来？",
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BUILDER.0-0r.next": "回答",
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BUILDER.0-1r.char": "因为塔在那里！",
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BUILDER.0-1r.next": "继续",
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BUILDER.0-2r.ancient": "...",
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BUILDER.1-0r.char": "说真的，你们应该修一部电梯。",
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BUILDER.1-1r.ancient": "预算不足。",
  /*------------- 建筑师 × 野蛮人 ----------- */
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0r.ancient": "野蛮人。你脑子里的怒气，和这座塔一样高。",
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0r.next": "回答",
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1r.char": "我的拳头，比你的规矩高。",
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1r.next": "继续",
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-2r.ancient": "哼。至少你不是那些只会发抖的废物。",
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BARBARIAN.1-0r.ancient": "又来了。你的族人都死光了，你还在挥着斧子。",
  "THE_ARCHITECT.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0r.ancient": "野蛮人，我倒是想看看，你的愤怒能把这座塔撞出多大的裂缝。",
  /*------------- 瓦库 × 工匠 ----------- */
  "VAKUU.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.ancient": "工匠，你在寻找材料，而我在寻找……[sine]有趣的交易[/sine]。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BUILDER.0-0.next": "回应",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.char": "交易？我可没什么能给你的。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BUILDER.0-1.next": "继续",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BUILDER.0-2.ancient": "你有。你的[sine]时间[/sine]。\n签下这份契约，你的双手就再也不会疲惫。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BUILDER.1-0r.ancient": "又见面了，工匠。\n这次，我想要你的[sine]灵感[/sine]——只要一点点。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.ancient": "你造的机器越多，就有越多东西需要修理。\n不如和我做笔交易：我把建筑师的心脏给你，你把你的[sine]名字[/sine]给我。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BUILDER.2-0.next": "回应",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.char": "名字？没了名字，我还怎么在作品上刻印记？",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BUILDER.2-1.next": "继续",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BUILDER.2-2.ancient": "呵呵……那你就慢慢修吧。\n我会在[sine]终点[/sine]等你。",
  /*------------- 瓦库 × 野蛮人 ----------- */
  "VAKUU.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.ancient": "壮士，你渴求力量，而我渴求……[sine]代价[/sine]。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-0.next": "回应",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.char": "力量？我有的是力气。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-1.next": "继续",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BARBARIAN.0-2.ancient": "那我们就谈[sine]别的[/sine]。\n你的勇气，可以换一份不错的契约。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BARBARIAN.1-0r.ancient": "又来了，大个子。\n听说你还有脑子？那正好，聪明人签起契约来，格外[sine]美味[/sine]。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.ancient": "我见过你的族人，他们倒下时还在喊着你的名字。\n想替他们讨个说法吗？签了它，我就告诉你[sine]真相[/sine]。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-0.next": "回应",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.char": "……真相，我自己会去找。",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-1.next": "继续",
  "VAKUU.talk.DICEOMANCER_CHARACTER_BARBARIAN.2-2.ancient": "呵……那祝你找得顺利。\n我会在[sine]终点[/sine]，等你改变主意。"

}